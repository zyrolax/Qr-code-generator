# Copy to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# MongoDB (docker-compose default)
MONGODB_URI=mongodb://localhost:27017/requesto

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Cookie lifetime in days
JWT_EXPIRES_DAYS=7

# Where the client runs. Used for CORS and for building public sticker URLs.
# Dev: http://localhost:5173   Prod: https://requesto.in
CLIENT_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:5173

# Email (Nodemailer). In development, emails are logged to the console instead
# of being sent, so these can stay blank locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Requesto <no-reply@requesto.in>"
