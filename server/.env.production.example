# Copy to server/.env on the VPS and fill in JWT_SECRET.
# Generate a secret with:  openssl rand -hex 32

# A less-common port to avoid clashing with your existing app(s).
PORT=4010
NODE_ENV=production

# Points at the Docker MongoDB from deploy/docker-compose.test.yml (localhost:27018),
# using a dedicated database so it can't touch any existing data.
MONGODB_URI=mongodb://127.0.0.1:27018/requesto_test

JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE
JWT_EXPIRES_DAYS=7

# The test subdomain. Same origin for client + API, so cookies just work.
CLIENT_ORIGIN=https://test.requesto.in
BASE_URL=https://test.requesto.in

# Email: leave blank to keep logging notifications to the PM2 log instead of
# sending. Fill in to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Requesto <no-reply@requesto.in>"
